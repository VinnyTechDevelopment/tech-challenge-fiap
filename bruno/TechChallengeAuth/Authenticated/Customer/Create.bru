meta {
  name: Create Customer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/customer
  body: json
  auth: inherit
}

body:json {
  {
    "name": "João Silva",
    "email": "joao@example.com",
    "document": "52998224725",
    "phone": "71850229082"
  }
}

script:post-response {
  if (res.getStatus() < 300) bru.setVar('customerId', res.getBody().customer.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
