meta {
  name: Abrir OS (inicia a Saga)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/service-order
  body: json
  auth: inherit
}

body:json {
  {
    "customer_id": "{{customerId}}",
    "vehicle_id": "{{vehicleId}}",
    "services": [
      { "service_id": "{{serviceId}}", "quantity": 1 }
    ],
    "items": [
      { "item_id": "{{itemId}}", "quantity": 2 }
    ]
  }
}

docs {
  Responde 202. Preços vêm do execution-service (REST). O orçamento é gerado de forma assíncrona pelo billing-service (SQS).
}

settings {
  encodeUrl: true
  timeout: 0
}
