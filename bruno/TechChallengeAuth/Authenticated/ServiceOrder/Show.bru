meta {
  name: Show Service Order
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/service-order/{{serviceOrderId}}
  body: none
  auth: inherit
}

script:post-response {
  const saga = res.getBody().saga || {};
  if (saga.approval_url) bru.setVar('approvalToken', saga.approval_url.split('/quotes/')[1].split('/')[0]);
  if (saga.payment_id) bru.setVar('paymentId', saga.payment_id);
}

settings {
  encodeUrl: true
  timeout: 0
}
