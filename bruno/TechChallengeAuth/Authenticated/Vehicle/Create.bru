meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/vehicle
  body: json
  auth: inherit
}

body:json {
  {
    "brand": "Hyundai",
    "model": "I30",
    "year": "2013",
    "plate": "EFB1D30"
  }
}

script:post-response {
  if (res.getStatus() < 300) bru.setVar('vehicleId', res.getBody().id);
}

settings {
  encodeUrl: true
  timeout: 0
}
