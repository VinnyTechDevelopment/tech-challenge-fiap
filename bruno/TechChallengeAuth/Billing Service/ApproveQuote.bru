meta {
  name: Cliente aprova orçamento (link do e-mail)
  type: http
  seq: 1
}

get {
  url: {{billingUrl}}/billing/quotes/{{approvalToken}}/approve
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() < 300) bru.setVar('paymentId', res.getBody().payment_id);
  if (res.getStatus() < 300) bru.setVar('paymentUrl', res.getBody().payment_url);
}

docs {
  approvalToken é preenchido ao rodar "Detalhar OS". Abra o payment_url no navegador para pagar no Mercado Pago sandbox.
}

settings {
  encodeUrl: true
  timeout: 0
}
