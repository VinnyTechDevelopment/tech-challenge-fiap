meta {
  name: Simular pagamento (só PAYMENT_GATEWAY=fake)
  type: http
  seq: 4
}

post {
  url: {{billingUrl}}/billing/payments/{{paymentId}}/simulate
  body: json
  auth: none
}

body:json {
  {
    "status": "approved"
  }
}

docs {
  Use "rejected" para demonstrar a compensação. Com o Mercado Pago real responde 404.
}

settings {
  encodeUrl: true
  timeout: 0
}
