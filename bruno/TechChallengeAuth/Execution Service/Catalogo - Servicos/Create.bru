meta {
  name: Criar serviço
  type: http
  seq: 3
}

post {
  url: {{executionUrl}}/catalog/services
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Revisao completa",
    "price": 300
  }
}

script:post-response {
  if (res.getStatus() < 300) bru.setVar('serviceId', res.getBody().id);
}

settings {
  encodeUrl: true
  timeout: 0
}
